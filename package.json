{
  "name": "shadcn-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:registry",
    "dev": "vp dev --port 3000",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prebuild": "npm run build:registry && npm run build:search-index",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "build:search-index": "node scripts/build-search-index.ts",
    "check:search-index": "node scripts/check-search-index.ts",
    "build:shiki": "node scripts/build-shiki-bundle.ts && vp fmt",
    "build:registry": "node scripts/build-registry.ts && vp fmt"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.11",
    "msw": "^2.15.0",
    "nitro": "3.0.260610-beta",
    "shadcn": "^4.15.0",
    "shiki-codegen": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-plus": "0.3.2",
    "vitest-browser-react": "^2.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.12.1 <13",
      "onFail": "warn"
    }
  }
}
