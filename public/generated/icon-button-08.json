  "code": "import { BellIcon, SearchIcon, SettingsIcon } from \"lucide-react\";\n\nimport { IconButton } from \"@/components/icon-button/icon-button\";\nimport { Tooltip, TooltipTrigger } from \"@/components/ui/tooltip\";\n\nexport default function IconButtonDemo() {\n  return (\n    <div className=\"flex w-full items-center justify-center gap-4\">\n      <TooltipTrigger delay={300}>\n        <IconButton aria-label=\"Search\" variant=\"standard\">\n          <SearchIcon />\n        </IconButton>\n        <Tooltip>Search</Tooltip>\n      </TooltipTrigger>\n      <TooltipTrigger delay={300}>\n        <IconButton aria-label=\"Notifications\" variant=\"tonal\">\n          <BellIcon />\n        </IconButton>\n        <Tooltip>Notifications</Tooltip>\n      </TooltipTrigger>\n      <TooltipTrigger delay={300}>\n        <IconButton aria-label=\"Settings\" variant=\"outlined\">\n          <SettingsIcon />\n        </IconButton>\n        <Tooltip>Settings</Tooltip>\n      </TooltipTrigger>\n    </div>\n  );\n}",
