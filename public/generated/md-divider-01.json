  "code": "import { MDDivider } from \"@/ui/material-design/components/md-divider/md-divider\";\n\nconst sections = [\n  { title: \"Today\", detail: \"3 new updates\" },\n  { title: \"This week\", detail: \"12 conversations\" },\n  { title: \"Archive\", detail: \"48 saved items\" },\n] as const;\n\nexport default function MDDividerDemo() {\n  return (\n    <div className=\"w-full max-w-md rounded-[28px] bg-[#fffbfe] py-2 text-[#1d1b20] shadow-sm ring-1 ring-[#cac4d0] dark:bg-[#211f26] dark:text-[#e6e0e9] dark:ring-[#49454f]\">\n      {sections.map((section, index) => (\n        <div key={section.title}>\n          <div className=\"px-6 py-4\">\n            <p className=\"text-sm leading-5 font-medium\">{section.title}</p>\n            <p className=\"mt-1 text-sm leading-5 text-[#49454f] dark:text-[#cac4d0]\">\n              {section.detail}\n            </p>\n          </div>\n          {index < sections.length - 1 ? <MDDivider /> : null}\n        </div>\n      ))}\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { MDDivider } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-divider/md-divider\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> sections</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { title: </span><span style=\"color:#9ECBFF\">\"Today\"</span><span style=\"color:#E1E4E8\">, detail: </span><span style=\"color:#9ECBFF\">\"3 new updates\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { title: </span><span style=\"color:#9ECBFF\">\"This week\"</span><span style=\"color:#E1E4E8\">, detail: </span><span style=\"color:#9ECBFF\">\"12 conversations\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { title: </span><span style=\"color:#9ECBFF\">\"Archive\"</span><span style=\"color:#E1E4E8\">, detail: </span><span style=\"color:#9ECBFF\">\"48 saved items\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">] </span><span style=\"color:#F97583\">as</span><span style=\"color:#F97583\"> const</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> MDDividerDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"c