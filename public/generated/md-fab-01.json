{
  "code": "import { EditIcon } from \"lucide-react\";\n\nimport { MDFABButton } from \"@/ui/material-design/components/md-fab/md-fab\";\n\nconst sizes = [\"small\", \"medium\", \"large\"] as const;\n\nexport default function MDFABDemo() {\n  return (\n    <div className=\"flex w-full flex-wrap items-center justify-center gap-5\">\n      {sizes.map((size) => (\n        <div className=\"grid justify-items-center gap-3\" key={size}>\n          <MDFABButton aria-label={`${size} edit action`} size={size}>\n            <EditIcon />\n          </MDFABButton>\n          <span className=\"text-xs capitalize text-muted-foreground\">\n            {size}\n          </span>\n        </div>\n      ))}\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { EditIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { MDFABButton } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-fab/md-fab\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> sizes</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span><span style=\"color:#9ECBFF\">\"small\"</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#9ECBFF\">\"medium\"</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#9ECBFF\">\"large\"</span><span style=\"color:#E1E4E8\">] </span><span style=\"color:#F97583\">as</span><span style=\"color:#F97583\"> const</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> MDFABDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;</span><span style=\"color:#85E89D\">div</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"flex w-full flex-wrap items-center justify-center gap-5\"</span><span style=\"color:#E