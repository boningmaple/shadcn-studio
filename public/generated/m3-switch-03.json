lor:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#B392F0\"> isSelected</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{airplaneMode} </span><span style=\"color:#B392F0\">onChange</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{setAirplaneMode}></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        Airplane mode</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#B392F0\"> isDisabled</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{airplaneMode}>Cellular data&#x3C;/</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#B392F0\"> defaultSelected</span><span style=\"color:#B392F0\"> isDisabled</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{airplaneMode}></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        Personal hotspot</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">M3Switch</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#85E89D\">p</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"mt-3 text-sm leading-5 text-[#49454f] dark:text-[#cac4d0]\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4