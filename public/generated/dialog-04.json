{
  "code": "import { SaveIcon } from \"lucide-react\";\n\nimport { Button } from \"@/components/button/button\";\nimport {\n  DialogTrigger,\n  FullScreenDialog,\n  FullScreenDialogBar,\n  FullScreenDialogContent,\n  FullScreenDialogTitle,\n} from \"@/components/dialog/dialog\";\n\nexport default function DialogDemo() {\n  return (\n    <DialogTrigger>\n      <Button variant=\"filled\">Open full screen</Button>\n      <FullScreenDialog>\n        <FullScreenDialogBar>\n          <FullScreenDialogTitle>Edit profile</FullScreenDialogTitle>\n          <Button slot=\"close\" variant=\"text\">\n            <SaveIcon />\n            Save\n          </Button>\n        </FullScreenDialogBar>\n        <FullScreenDialogContent className=\"mx-auto grid w-full max-w-3xl gap-4\">\n          <p>\n            Full-screen dialogs support complex tasks that need more room than a\n            standard dialog.\n          </p>\n          <div className=\"grid gap-3 rounded-[16px] bg-[#f7f2fa] p-4 dark:bg-[#211f26]\">\n            <span className=\"font-medium text-[#1d1b20] dark:text-[#e6e0e9]\">\n              Contact details\n            </span>\n            <span>\n              Add profile fields, review permissions, and save when the task is\n              complete.\n            </span>\n          </div>\n        </FullScreenDialogContent>\n      </FullScreenDialog>\n    </DialogTrigger>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { SaveIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Button } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/button/button\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogTrigger,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  FullScreenDialog,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  FullScreenDialogBar,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  FullScreenDialogContent,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  FullScreenDialogTitle,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/dialog/dialog\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> DialogDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;</span><span style=\"color:#79B8FF\">DialogTrigger</span><span style=\"color:#E1E4E8\">></span></span>