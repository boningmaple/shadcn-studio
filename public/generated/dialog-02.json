  "code": "import { AlertTriangleIcon } from \"lucide-react\";\n\nimport { Button } from \"@/components/button/button\";\nimport {\n  Dialog,\n  DialogActionButton,\n  DialogActions,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/components/dialog/dialog\";\n\nexport default function DialogDemo() {\n  return (\n    <DialogTrigger>\n      <Button variant=\"outlined\">Open alert</Button>\n      <Dialog role=\"alertdialog\">\n        <DialogHeader>\n          <AlertTriangleIcon className=\"size-6 text-[#b3261e] dark:text-[#f2b8b5]\" />\n          <DialogTitle>Delete project?</DialogTitle>\n        </DialogHeader>\n        <DialogContent>\n          This permanently removes project files, comments, and release notes\n          from the workspace.\n        </DialogContent>\n        <DialogActions>\n          <DialogActionButton slot=\"close\">Cancel</DialogActionButton>\n          <DialogActionButton slot=\"close\">Delete</DialogActionButton>\n        </DialogActions>\n      </Dialog>\n    </DialogTrigger>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { AlertTriangleIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Button } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/button/button\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  Dialog,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogActionButton,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogActions,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogContent,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogHeader,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogTitle,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  DialogTrigger,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/dialog/dialog\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> DialogDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"