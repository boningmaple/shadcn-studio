{
  "code": "import { UNSTABLE_ToastQueue } from \"react-aria-components\";\n\nimport { MDButton } from \"@/ui/material-design/components/md-button/md-button\";\nimport {\n  MDSnackbarRegion,\n  type MDSnackbarContent,\n} from \"@/ui/material-design/components/md-snackbar/md-snackbar\";\n\nconst queue = new UNSTABLE_ToastQueue<MDSnackbarContent>({\n  maxVisibleToasts: 1,\n});\n\nexport default function MDSnackbarDemo() {\n  return (\n    <>\n      <MDButton\n        variant=\"tonal\"\n        onPress={() =>\n          queue.add(\n            {\n              actionLabel: \"Undo\",\n              message: \"Message sent.\",\n              onAction: () =>\n                queue.add({ message: \"Message restored.\" }, { timeout: 3500 }),\n            },\n            { timeout: 5000 },\n          )\n        }\n      >\n        Send message\n      </MDButton>\n      <MDSnackbarRegion queue={queue} />\n    </>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { UNSTABLE_ToastQueue } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"react-aria-components\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { MDButton } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-button/md-button\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDSnackbarRegion,</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  type</span><span style=\"color:#E1E4E8\"> MDSnackbarContent,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-snackbar/md-snackbar\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> queue</span><span style=\"color:#F97583\"> =</span><span style=\"color:#F97583\"> new</span><span style=\"color:#B392F0\"> UNSTABLE_ToastQueue</span><span style=\"color:#E1E4E8\">&#x3C;</span><span style=\"color:#B392F0\">MDSnackbarContent</span><span style=\"color:#E1E4E8\">>({</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  maxVisibleToasts: </span><span style=\"color:#79B8FF\">1</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> MDSnackbarDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">MDButton</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">        variant</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"tonal\"</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">        onPress</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{() </span><span style=\"color:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          queue.</span><span style=\"color:#B392F0\">add</span><span style=\"color:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              actionLabel: </span><span style=\"color:#9ECBFF\">\"Undo\"</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              message: </span><span style=\"color:#9ECBFF\">\"Message sent.\"</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">              onAction</span><span style=\"color:#E1E4E8\">: () </span><span style=\"color:#F97583\">=></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                queue.</span><span style=\"color:#B392F0\">add</span><span style=\"color:#E1E4E8\">({ message: </span><span style=\"color:#9ECBFF\">\"Message restored.\"</span><span style=\"color:#E1E4E8\"> }, { timeout: </span><span style=\"color:#79B8FF\">3500</span><span style=\"color:#E1E4E8\"> }),</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            { timeout: </span><span style=\"color:#79B8FF\">5000</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          )</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      ></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        Send message</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">MDButton</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">MDSnackbarRegion</span><span style=\"color:#B392F0\"> queue</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{queue} /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span></code></pre>"
