 class=\"line\"><span style=\"color:#B392F0\">            icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">destination.icon</span><span style=\"color:#E1E4E8\"> />}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">            isSelected</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{selected </span><span style=\"color:#F97583\">===</span><span style=\"color:#E1E4E8\"> destination.id}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">            key</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{destination.id}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">            label</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{destination.label}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">            labelVisibility</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"always\"</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">            onPress</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{() </span><span style=\"color:#F97583\">=></span><span style=\"color:#B392F0\"> setSelected</span><span style=\"color:#E1E4E8\">(destination.id)}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        ))}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">NavigationRailContent</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/</span><span style=\"color:#79B8FF\">NavigationRail</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span></cod