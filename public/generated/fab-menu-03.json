{
  "code": "import { ArchiveIcon, ForwardIcon, TrashIcon } from \"lucide-react\";\n\nimport { FABMenu, FABMenuItem } from \"@/components/fab-menu/fab-menu\";\n\nexport default function FABMenuDemo() {\n  return (\n    <div className=\"flex w-full justify-center py-16\">\n      <FABMenu color=\"tertiary\" defaultOpen label=\"Message actions\">\n        <FABMenuItem icon={<ForwardIcon />}>Forward</FABMenuItem>\n        <FABMenuItem icon={<ArchiveIcon />}>Archive</FABMenuItem>\n        <FABMenuItem icon={<TrashIcon />} isDisabled>\n          Delete\n        </FABMenuItem>\n      </FABMenu>\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { ArchiveIcon, ForwardIcon, TrashIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { FABMenu, FABMenuItem } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/fab-menu/fab-menu\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> FABMenuDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;</span><span style=\"color:#85E89D\">div</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"flex w-full justify-center py-16\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;</span><span style=\"color:#79B8FF\">FABMenu</span><span style=\"color:#B392F0\"> color</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"tertiary\"</span><span style=\"color:#B392F0\"> defaultOpen</span><span style=\"color:#B392F0\"> label</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"Message actions\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8