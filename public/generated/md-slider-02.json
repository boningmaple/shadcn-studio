  "code": "import { MDSlider } from \"@/ui/material-design/components/md-slider/md-slider\";\n\nexport default function MDSliderDemo() {\n  return (\n    <div className=\"grid w-full max-w-lg gap-7\">\n      <MDSlider\n        defaultValue={30}\n        maxValue={100}\n        minValue={0}\n        showTicks\n        step={10}\n      >\n        Sound level\n      </MDSlider>\n      <MDSlider defaultValue={15} maxValue={60} minValue={0} showTicks step={5}>\n        Buffer size\n      </MDSlider>\n      <MDSlider\n        defaultValue={4}\n        formatOptions={{ maximumFractionDigits: 0 }}\n        maxValue={8}\n        minValue={1}\n        showTicks\n        step={1}\n      >\n        Review score\n      </MDSlider>\n    </div>\n  );\n}",
