{
  "code": "import { MDDivider } from \"@/ui/material-design/components/md-divider/md-divider\";\n\nconst stats = [\n  { value: \"18\", label: \"Active\" },\n  { value: \"42\", label: \"Queued\" },\n  { value: \"7\", label: \"Paused\" },\n] as const;\n\nexport default function MDDividerDemo() {\n  return (\n    <div className=\"flex h-28 w-full max-w-lg items-stretch rounded-[28px] bg-[#fffbfe] px-4 py-5 text-[#1d1b20] shadow-sm ring-1 ring-[#cac4d0] dark:bg-[#211f26] dark:text-[#e6e0e9] dark:ring-[#49454f]\">\n      {stats.map((stat, index) => (\n        <div className=\"flex min-w-0 flex-1 items-stretch\" key={stat.label}>\n          <div className=\"flex min-w-0 flex-1 flex-col items-center justify-center px-3 text-center\">\n            <span className=\"text-2xl leading-8 font-medium\">{stat.value}</span>\n            <span className=\"mt-1 text-sm leading-5 text-[#49454f] dark:text-[#cac4d0]\">\n              {stat.label}\n            </span>\n          </div>\n          {index < stats.length - 1 ? (\n            <MDDivider inset=\"both\" orientation=\"vertical\" />\n          ) : null}\n        </div>\n      ))}\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { MDDivider } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-divider/md-divider\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> stats</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { value: </span><span style=\"color:#9ECBFF\">\"18\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Active\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { value: </span><span style=\"color:#9ECBFF\">\"42\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Queued\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { value: </span><span style=\"color:#9ECBFF\">\"7\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Paused\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">] </span><span style=\"color:#F97583\">as</span><span style=\"color:#F97583\"> const</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> MDDividerDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"