{
  "code": "import { CheckCircle2Icon, MoreVerticalIcon } from \"lucide-react\";\n\nimport {\n  MDBadge,\n  MDBadgeAnchor,\n} from \"@/ui/material-design/components/md-badge/md-badge\";\nimport {\n  MDCard,\n  MDCardActions,\n  MDCardContent,\n  MDCardHeader,\n} from \"@/ui/material-design/components/md-card/md-card\";\nimport { MDDivider } from \"@/ui/material-design/components/md-divider/md-divider\";\nimport { MDIconButton } from \"@/ui/material-design/components/md-icon-button/md-icon-button\";\n\nconst updates = [\"Tokens synced\", \"Storybook reviewed\", \"Docs ready\"];\n\nexport default function MDCardDemo() {\n  return (\n    <MDCard className=\"w-full max-w-md\" variant=\"elevated\">\n      <MDCardHeader>\n        <div className=\"flex items-start justify-between gap-4\">\n          <div className=\"grid gap-1\">\n            <span className=\"text-base leading-6 font-medium\">\n              Release readiness\n            </span>\n            <span className=\"text-sm leading-5 text-[#49454f] dark:text-[#cac4d0]\">\n              Design system checklist\n            </span>\n          </div>\n          <MDBadgeAnchor>\n            <MDIconButton\n              aria-label=\"More actions\"\n              size=\"xs\"\n              variant=\"standard\"\n            >\n              <MoreVerticalIcon />\n            </MDIconButton>\n            <MDBadge>3</MDBadge>\n          </MDBadgeAnchor>\n        </div>\n      </MDCardHeader>\n      <MDCardContent className=\"grid gap-3\">\n        {updates.map((update, index) => (\n          <div className=\"grid gap-3\" key={update}>\n            <div className=\"flex items-center gap-3\">\n              <CheckCircle2Icon className=\"size-5 text-[#386a20] dark:text-[#b6f397]\" />\n              <span>{update}</span>\n            </div>\n            {index === updates.length - 1 ? null : <MDDivider inset=\"start\" />}\n          </div>\n        ))}\n      </MDCardContent>\n      <MDCardActions>\n        <span className=\"px-3 text-sm leading-8 font-medium text-[#6750a4] dark:text-[#d0bcff]\">\n          Ready\n        </span>\n      </MDCardActions>\n    </MDCard>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { CheckCircle2Icon, MoreVerticalIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDBadge,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDBadgeAnchor,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-badge/md-badge\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCard,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCardActions,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCardContent,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCardHeader,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-card/md-card\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { MDDivider } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-divider/md-divider\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E