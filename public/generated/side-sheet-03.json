#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;</span><span style=\"color:#79B8FF\">SideSheetTitle</span><span style=\"color:#E1E4E8\">>Settings&#x3C;/</span><span style=\"color:#79B8FF\">SideSheetTitle</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;</span><span style=\"color:#79B8FF\">SideSheetCloseButton</span><span style=\"color:#E1E4E8\"> /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;/</span><span style=\"color:#79B8FF\">SideSheetHeader</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">SideSheetDivider</span><span style=\"color:#E1E4E8\"> /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">SideSheetBody</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"px-0 py-2\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;</span><span style=\"color:#85E89D\">div</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"grid\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            {settings.</span><span style=\"color:#B392F0\">map</span><span style=\"color:#E1E4E8\">((</span><span style=\"color:#FFAB70\">item</span><span style=\"color:#E1E4E8\">) </span><span style=\"color:#F97583\">=></span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              &#x3C;</span><span style=\"color:#85E89D\">button</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">                className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"grid min-h-14 grid-cols-[40px_minmax(0,1fr)] items-center gap-4 px-6 text-left text-[#1d1b20] outline-none transition-colors hover:bg-[#1d1b20]/8 focus-visible:bg-[#1d1b20]/10 dark:text-[#e6e0e9] dark:hover:bg-[#e6e0e9]/8 dark:focus-visible:bg-[#e6e0e9]/10\"</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">                key</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{item.label}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">                type</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"button\"</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              ></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                &#x3C;</span><span style=\"color:#79B8FF\">item.icon</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"size-6 text-[#49454f] dark:text-[#cac4d0]\"</span><span style=\"color:#E1E4E8\"> /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                &#x3C;</span><span style=\"color:#85E89D\">span</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"truncate text-base leading-6\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                  {item.label}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                &#x3C;/</span><span style=\"color:#85E89D\">span</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              &#x3C;/</span><span style=\"color:#85E89D\">button</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            ))}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;/</span><span style=\"color:#79B8FF\">SideSheetBody</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">ModalSideSheet</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/</span><span style=\"color:#79B8FF\">SideSheetTrigger</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span></code></pre>"
