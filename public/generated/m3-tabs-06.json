><span style=\"color:#E1E4E8\">>Active&#x3C;/</span><span style=\"color:#79B8FF\">M3Tab</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              &#x3C;</span><span style=\"color:#79B8FF\">M3Tab</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{state.className} </span><span style=\"color:#B392F0\">id</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"inactive\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">                Inactive</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">              &#x3C;/</span><span style=\"color:#79B8FF\">M3Tab</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            &#x3C;/</span><span style=\"color:#79B8FF\">M3TabList</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;/</span><span style=\"color:#79B8FF\">M3Tabs</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      ))}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span></code></pre>"
