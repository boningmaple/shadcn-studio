  "code": "import * as React from \"react\";\n\nimport {\n  MDCheckbox,\n  MDCheckboxGroup,\n} from \"@/ui/material-design/components/md-checkbox/md-checkbox\";\n\nconst items = [\"camera\", \"microphone\", \"location\"] as const;\n\nexport default function MDCheckboxDemo() {\n  const [selected, setSelected] = React.useState<string[]>([\"camera\"]);\n  const allSelected = selected.length === items.length;\n  const isIndeterminate = selected.length > 0 && !allSelected;\n\n  function toggleAll(isSelected: boolean) {\n    setSelected(isSelected ? [...items] : []);\n  }\n\n  return (\n    <div className=\"grid w-full max-w-sm gap-2\">\n      <MDCheckbox\n        isIndeterminate={isIndeterminate}\n        isSelected={allSelected}\n        onChange={toggleAll}\n      >\n        Enable all permissions\n      </MDCheckbox>\n      <MDCheckboxGroup\n        aria-label=\"Permission choices\"\n        className=\"ms-13 gap-1\"\n        onChange={setSelected}\n        value={selected}\n      >\n        <MDCheckbox value=\"camera\">Camera</MDCheckbox>\n        <MDCheckbox value=\"microphone\">Microphone</MDCheckbox>\n        <MDCheckbox value=\"location\">Location</MDCheckbox>\n      </MDCheckboxGroup>\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#79B8FF\"> *</span><span style=\"color:#F97583\"> as</span><span style=\"color:#E1E4E8\"> React </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCheckbox,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  MDCheckboxGroup,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/ui/material-design/components/md-checkbox/md-checkbox\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> items</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span><span style=\"color:#9ECBFF\">\"camera\"</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#9ECBFF\">\"microphone\"</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#9ECBFF\">\"location\"</span><span style=\"color:#E1E4E8\">] </span><span style=\"color:#F97583\">as</span><span style=\"color:#F97583\"> const</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> MDCheckboxDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  const</span><span style=\"color:#E1E4E8\"> [</span><span style=\"