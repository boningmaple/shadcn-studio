  "code": "import { BellIcon } from \"lucide-react\";\n\nimport { Badge, BadgeAnchor } from \"@/components/badge/badge\";\nimport { Button } from \"@/components/button/button\";\n\nconst directions = [\n  {\n    accessibleLabel: \"Notifications, 7 unread\",\n    direction: \"ltr\",\n    label: \"Left to right\",\n  },\n  {\n    accessibleLabel: \"الإشعارات، 7 غير مقروءة\",\n    direction: \"rtl\",\n    label: \"من اليمين إلى اليسار\",\n  },\n] as const;\n\nexport default function BadgeDemo() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-8\">\n      {directions.map(({ accessibleLabel, direction, label }) => (\n        <div\n          className=\"flex flex-col items-center gap-3\"\n          dir={direction}\n          key={direction}\n        >\n          <Button aria-label={accessibleLabel} variant=\"tonal\">\n            <BadgeAnchor>\n              <BellIcon className=\"size-6\" />\n              <Badge aria-hidden=\"true\">7</Badge>\n            </BadgeAnchor>\n          </Button>\n          <span className=\"text-xs text-muted-foreground\">{label}</span>\n        </div>\n      ))}\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { BellIcon } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"lucide-react\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Badge, BadgeAnchor } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/badge/badge\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Button } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/button/button\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> directions</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    accessibleLabel: </span><span style=\"color:#9ECBFF\">\"Notifications, 7 unread\"</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    direction: </span><span style=\"color:#9ECBFF\">\"ltr\"</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    label: </span><span style=\"color:#9ECBFF\">\"Left to right\"</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    accessibleLabel: </span><span sty