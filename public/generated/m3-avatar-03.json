{
  "code": "import {\n  Avatar,\n  AvatarBadge,\n  AvatarFallback,\n  AvatarImage,\n} from \"@/components/ui/avatar\";\n\nconst statuses = [\n  { color: \"bg-emerald-500\", label: \"Online\", seed: \"Jack\" },\n  { color: \"bg-amber-400\", label: \"Away\", seed: \"Chase\" },\n  { color: \"bg-rose-500\", label: \"Busy\", seed: \"Ryker\" },\n] as const;\n\nexport default function M3AvatarDemo() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-6\">\n      {statuses.map(({ color, label, seed }) => (\n        <div className=\"flex flex-col items-center gap-3\" key={label}>\n          <Avatar size=\"lg\">\n            <AvatarImage\n              alt={seed}\n              src={`https://api.dicebear.com/9.x/lorelei/svg?seed=${seed}&backgroundColor=ffffff`}\n            />\n            <AvatarFallback>{seed.charAt(0)}</AvatarFallback>\n            <AvatarBadge aria-label={label} className={color} role=\"status\" />\n          </Avatar>\n          <span className=\"text-xs text-muted-foreground\">{label}</span>\n        </div>\n      ))}\n    </div>\n  );\n}",
  "html": "<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  Avatar,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  AvatarBadge,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  AvatarFallback,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  AvatarImage,</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">} </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> \"@/components/ui/avatar\"</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> statuses</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> [</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { color: </span><span style=\"color:#9ECBFF\">\"bg-emerald-500\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Online\"</span><span style=\"color:#E1E4E8\">, seed: </span><span style=\"color:#9ECBFF\">\"Jack\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { color: </span><span style=\"color:#9ECBFF\">\"bg-amber-400\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Away\"</span><span style=\"color:#E1E4E8\">, seed: </span><span style=\"color:#9ECBFF\">\"Chase\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  { color: </span><span style=\"color:#9ECBFF\">\"bg-rose-500\"</span><span style=\"color:#E1E4E8\">, label: </span><span style=\"color:#9ECBFF\">\"Busy\"</span><span style=\"color:#E1E4E8\">, seed: </span><span style=\"color:#9ECBFF\">\"Ryker\"</span><span style=\"color:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">] </span><span style=\"color:#F97583\">as</span><span style=\"color:#F97583\"> const</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#F97583\"> default</span><span style=\"color:#F97583\"> function</span><span style=\"color:#B392F0\"> M3AvatarDemo</span><span style=\"color:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">  return</span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;</span><span style=\"color:#85E89D\">div</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"flex flex-wrap items-center justify-center gap-6\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      {statuses.</span><span style=\"color:#B392F0\">map</span><span style=\"color:#E1E4E8\">(({ </span><span style=\"color:#FFAB70\">color</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#FFAB70\">label</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#FFAB70\">seed</span><span style=\"color:#E1E4E8\"> }) </span><span style=\"color:#F97583\">=></span><span style=\"color:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#85E89D\">div</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"flex flex-col items-center gap-3\"</span><span style=\"color:#B392F0\"> key</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{label}></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;</span><span style=\"color:#79B8FF\">Avatar</span><span style=\"color:#B392F0\">