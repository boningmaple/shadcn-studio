{
  "code": "import {\n  ArchiveIcon,\n  BellIcon,\n  DownloadIcon,\n  SettingsIcon,\n  TrashIcon,\n} from \"lucide-react\";\n\nimport { IconButton } from \"@/components/icon-button/icon-button\";\nimport {\n  Menu,\n  MenuItem,\n  MenuSection,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@/components/menu/menu\";\n\nexport default function MenuDemo() {\n  return (\n    <MenuTrigger>\n      <IconButton aria-label=\"Open project actions\" variant=\"outlined\">\n        <SettingsIcon />\n      </IconButton>\n      <Menu>\n        <MenuSection title=\"Project\">\n          <MenuItem description=\"Save a local copy\" icon={<DownloadIcon />}>\n            Download\n          </MenuItem>\n          <MenuItem\n            description=\"Move out of the active list\"\n            icon={<ArchiveIcon />}\n          >\n            Archive\n          </MenuItem>\n        </MenuSection>\n        <MenuSeparator />\n        <MenuSection title=\"Notifications\">\n          <MenuItem icon={<BellIcon />}>Mute thread</MenuItem>\n          <MenuItem icon={<TrashIcon />} isDisabled>\n            Delete\n          </MenuItem>\n        </MenuSection>\n      </Menu>\n    </MenuTrigger>\n  );\n}",
