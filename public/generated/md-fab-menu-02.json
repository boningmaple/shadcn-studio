 style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"Capture\"</span><span style=\"color:#B392F0\"> placement</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"top\"</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#B392F0\"> icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">PenLineIcon</span><span style=\"color:#E1E4E8\"> />}>Note&#x3C;/</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#B392F0\"> icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">MicIcon</span><span style=\"color:#E1E4E8\"> />}>Voice memo&#x3C;/</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#B392F0\"> icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">VideoIcon</span><span style=\"color:#E1E4E8\"> />}>Video&#x3C;/</span><span style=\"color:#79B8FF\">MDFABMenuItem</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      &#x3C;/</span><span style=\"color:#79B8FF\">MDFABMenu</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\