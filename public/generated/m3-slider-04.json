  "code": "import { M3Slider } from \"@/material-3-ui/components/m3-slider/m3-slider\";\n\nexport default function M3SliderDemo() {\n  return (\n    <div className=\"grid w-full max-w-lg gap-7\">\n      <M3Slider\n        defaultValue={0.45}\n        formatOptions={{ style: \"percent\", maximumFractionDigits: 0 }}\n        maxValue={1}\n        minValue={0}\n        step={0.01}\n      >\n        Completion\n      </M3Slider>\n      <M3Slider\n        defaultValue={120}\n        formatOptions={{ style: \"currency\", currency: \"USD\" }}\n        maxValue={1000}\n        minValue={0}\n        step={10}\n      >\n        Daily budget\n      </M3Slider>\n      <M3Slider\n        defaultValue={22}\n        formatOptions={{ style: \"unit\", unit: \"celsius\" }}\n        maxValue={30}\n        minValue={10}\n      >\n        Target temperature\n      </M3Slider>\n    </div>\n  );\n}",
