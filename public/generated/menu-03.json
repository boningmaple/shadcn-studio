<span style=\"color:#79B8FF\">Menu</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">        defaultSelectedKeys</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{[</span><span style=\"color:#9ECBFF\">\"grid\"</span><span style=\"color:#E1E4E8\">]}</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">        selectionMode</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"single\"</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">        shouldCloseOnSelect</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{</span><span style=\"color:#79B8FF\">false</span><span style=\"color:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      ></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">MenuItem</span><span style=\"color:#B392F0\"> id</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"list\"</span><span style=\"color:#B392F0\"> icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">ListIcon</span><span style=\"color:#E1E4E8\"> />}></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          List</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;/</span><span style=\"color:#79B8FF\">MenuItem</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;</span><span style=\"color:#79B8FF\">MenuItem</span><span style=\"color:#B392F0\"> id</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"grid\"</span><span style=\"color:#B392F0\"> icon</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{&#x3C;</span><span style=\"color:#79B8FF\">LayoutGridIcon</span><span style=\"color:#E1E4E8\"> />}></span></span>\n<span class=\"line\"><span