  "code": "import { CompassIcon, LuggageIcon, PlaneIcon } from \"lucide-react\";\n\nimport {\n  Tab,\n  TabList,\n  TabPanel,\n  TabPanels,\n  Tabs,\n} from \"@/components/tabs/tabs\";\n\nexport default function TabsDemo() {\n  return (\n    <Tabs className=\"max-w-2xl\" defaultSelectedKey=\"flights\">\n      <TabList aria-label=\"Travel categories with icons\">\n        <Tab id=\"flights\">\n          <PlaneIcon />\n          Flights\n        </Tab>\n        <Tab id=\"trips\">\n          <LuggageIcon />\n          Trips\n        </Tab>\n        <Tab id=\"explore\">\n          <CompassIcon />\n          Explore\n        </Tab>\n      </TabList>\n      <TabPanels>\n        <TabPanel id=\"flights\">Find and manage upcoming flights.</TabPanel>\n        <TabPanel id=\"trips\">Review your saved travel plans.</TabPanel>\n        <TabPanel id=\"explore\">\n          Discover destinations for your next trip.\n        </TabPanel>\n      </TabPanels>\n    </Tabs>\n  );\n}",
