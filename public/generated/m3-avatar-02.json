</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">              src</span><span style=\"color:#F97583\">=</span><span style=\"color:#E1E4E8\">{</span><span style=\"color:#9ECBFF\">`https://api.dicebear.com/9.x/lorelei/svg?seed=${</span><span style=\"color:#E1E4E8\">seed</span><span style=\"color:#9ECBFF\">}&#x26;backgroundColor=ffffff`</span><span style=\"color:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            /></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">            &#x3C;</span><span style=\"color:#79B8FF\">AvatarFallback</span><span style=\"color:#E1E4E8\">>{seed.</span><span style=\"color:#B392F0\">charAt</span><span style=\"color:#E1E4E8\">(</span><span style=\"color:#79B8FF\">0</span><span style=\"color:#E1E4E8\">)}&#x3C;/</span><span style=\"color:#79B8FF\">AvatarFallback</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;/</span><span style=\"color:#79B8FF\">Avatar</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">          &#x3C;</span><span style=\"color:#85E89D\">span</span><span style=\"color:#B392F0\"> className</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">\"text-xs text-muted-foreground\"</span><span style=\"color:#E1E4E8\">>{label}&#x3C;/</span><span style=\"color:#85E89D\">span</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">        &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      ))}</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    &#x3C;/</span><span style=\"color:#85E89D\">div</span><span style=\"color:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"colo